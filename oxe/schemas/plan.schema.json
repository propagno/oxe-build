{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oxe.dev/schemas/plan.schema.json",
  "title": "OXE PLAN.json (schema_version 1)",
  "description": "Plano canônico gravado por /oxe-plan ao lado do PLAN.md. O runtime lê este arquivo; o PLAN.md é a leitura humana. Validado por `oxe-cc plan lint` (bin/lib/oxe-plan-json.cjs).",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "phase": { "type": ["string", "null"], "pattern": "^F\\d+$", "description": "Fase do PROGRAM.json que este plano implementa." },
    "summary": { "type": "string" },
    "acceptance_tests": {
      "description": "Testes de aceite escritos pelo /oxe-plan ANTES da execução. O runtime congela o hash no compile; o executor não pode escrevê-los e o verify reprova se mudarem (acceptance_tampered).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "files", "command"],
        "properties": {
          "criterion": { "type": "string", "pattern": "^A\\d+$" },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "command": { "type": "string", "minLength": 1 },
          "proves": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Nomes dos testes (ou `arquivo › nome`) que precisam aparecer como aprovados na saída do runner — Prova executada." }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "wave"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^T\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "wave": { "type": "integer", "minimum": 1 },
          "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^T\\d+$" }, "uniqueItems": true },
          "files": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "verify": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "manual": { "type": "array", "items": { "type": "string" } }
            }
          },
          "acceptance": { "type": "array", "items": { "type": "string", "pattern": "^A\\d+$" }, "uniqueItems": true },
          "decisions": { "type": "array", "items": { "type": "string", "pattern": "^D-\\d+$" } },
          "complexity": { "enum": ["XS", "S", "M", "L", "XL"] },
          "done": { "type": "boolean" }
        }
      }
    }
  }
}
